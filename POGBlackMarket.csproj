<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>POGBlackMarket</AssemblyName>
    <RootNamespace>POGBlackMarket</RootNamespace>
    <!-- The folder holding MelonLoader\ (with Il2CppAssemblies\): a mod manager profile. -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.config/r2modmanPlus-local/PitOfGoblin/profiles/Tests</GameDir>
    <POGLibDll Condition="'$(POGLibDll)' == ''">$(MSBuildThisFileDirectory)../POGLib/bin/Release/net6.0/POGLib.dll</POGLibDll>
    <POGConfigDll Condition="'$(POGConfigDll)' == ''">$(GameDir)/Mods/POGConfig.dll</POGConfigDll>
    <POGShopsDll Condition="'$(POGShopsDll)' == ''">$(MSBuildThisFileDirectory)../POGLib/Shops/bin/Release/net6.0/POGShops.dll</POGShopsDll>
    <MelonDir>$(GameDir)/MelonLoader/net6</MelonDir>
    <InteropDir>$(GameDir)/MelonLoader/Il2CppAssemblies</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="POGLib"><HintPath>$(POGLibDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="POGShops"><HintPath>$(POGShopsDll)</HintPath><Private>false</Private></Reference>
    <!-- Optional at runtime: only Page touches it, behind a NoInlining call. -->
    <Reference Include="POGConfig"><HintPath>$(POGConfigDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MelonDir)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MelonDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonDir)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(InteropDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(InteropDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Netcode.Runtime"><HintPath>$(InteropDir)/Unity.Netcode.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
